{
  "name": "@selfme-lab/desktop",
  "productName": "SelfMe Lab",
  "private": true,
  "version": "0.1.0",
  "description": "SelfMe Lab desktop experiment platform",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node ../../node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package:mac": "npm run build && node ../../scripts/clean-mac-output.mjs before && electron-builder --mac --dir && node ../../scripts/clean-mac-output.mjs after"
  },
  "dependencies": {
    "@weshell/xiangqi.js": "^1.0.3",
    "diff": "^9.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
